# Local backend configuration only. For Render, enter secrets in the service
# environment settings; Render supplies PORT automatically.
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
GEMINI_MODELS=gemini-2.5-flash
GEMINI_STT_MODEL=gemini-3.5-transcribe
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
GEMINI_LIVE_MODEL=gemini-3.8-live
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy
PORT=3000
HOST=0.0.0.0
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
GROQ_MODELS=openai/gpt-oss-20b
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000
