# Client-safe configuration. Provider API keys belong only in server/.env.
EXPO_PUBLIC_AI_BACKEND_URL=http://<LAPTOP_LAN_IP>:3000
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
EXPO_PUBLIC_GOOGLE_AUTH_WEB_CLIENT_ID=your_google_web_client_id

# Server-only configuration. Do not put real values in this file.
SUPABASE_URL=your_supabase_project_url
SUPABASE_JWT_AUDIENCE=authenticated
GEMINI_API_KEY=your_gemini_api_key
GEMINI_LIVE_MODEL=your_gemini_live_model
GEMINI_MODELS=your_gemini_models
GROQ_API_KEY=your_groq_api_key
GROQ_MODELS=your_groq_models
AI_BACKEND_API_KEY=your_backend_api_key
PORT=3000
