# Expo client configuration only. Backend provider keys belong in server/.env
# or the backend deployment's server-side environment variables.
EXPO_PUBLIC_AI_BACKEND_URL=https://your-remote-backend.example.com
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
EXPO_PUBLIC_GOOGLE_AUTH_WEB_CLIENT_ID=your_google_web_client_id
